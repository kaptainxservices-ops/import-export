# Secrets — this entry exists before any .env file does
.env
.env.*
!.env.example
*.pem
*.key

# Client data — real emails and attachments never go to git
samples/**
!samples/README.md

# The one exception: the stress-test files are invented from end to end — fictional
# companies, .example domains, made-up EANs — and they are what the pipeline is checked
# against, so they belong in the repository. Nothing from a real supplier goes in here.
!samples/stress/
!samples/stress/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node
node_modules/
dist/
.vercel/
.next/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
