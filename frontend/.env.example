# Copy to .env.local and fill in. Vite exposes anything prefixed VITE_ to the browser,
# so ONLY the publishable key belongs here. The secret key would be readable by anyone
# who opens the page, and it bypasses every row-level security policy.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The backend, for matching. Defaults to a local dev server if unset.
VITE_API_URL=http://127.0.0.1:8000
