# Copy to .env.local and fill in. Vite exposes anything prefixed VITE_ to the browser,
# so ONLY the publishable key belongs here. The secret key would be readable by anyone
# who opens the page, and it bypasses every row-level security policy.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The backend, for matching. Defaults to a local dev server if unset.
VITE_API_URL=http://127.0.0.1:8000

# The shared demo login, printed on the sign-in screen. Set BOTH or neither -- the
# block only renders when both are present, so the client's deployment hides it by
# leaving them unset. Kept out of the source so the password is not in git history.
#
# This account sees everything on whichever tenant it is attached to. Only point it
# at data you are content for a stranger to read.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
