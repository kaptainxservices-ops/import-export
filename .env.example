# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# Shared secret n8n sends in the X-Ingest-Token header.
# /ingest is a public URL: without this, anyone who finds it can post fake offers.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# --- Anthropic ---
# Set a spend limit in the Anthropic console BEFORE this key is ever used.
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-haiku-4-5-20251001
EXTRACT_MODEL=claude-sonnet-5

# --- Supabase ---
# Project Settings > API
SUPABASE_URL=

# The "secret key" (sb_secret_...), formerly called the service_role key.
# It bypasses row-level security, so it is the one key that must never reach a
# browser, a git commit, or the frontend. Backend and Render only.
SUPABASE_SECRET_KEY=

# The "publishable key" (sb_publishable_...) is NOT needed here — it belongs to the
# React dashboard in Phase 5, where it is safe precisely because RLS is enabled.

# --- Monitoring (Phase 7) ---
SENTRY_DSN=
