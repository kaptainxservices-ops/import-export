# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# Shared secret n8n sends in the X-Ingest-Token header.
# /ingest is a public URL: without this, anyone who finds it can post fake offers.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# --- The model ---
# Only used where the rules cannot decide: about 5 emails in 45, plus a handful of
# tables with headers in words we do not recognise. Leave it all blank and the system
# still runs — the undecidable minority goes to the review queue instead.

# Set a spend limit in the Anthropic console BEFORE this key is ever used.
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-haiku-4-5-20251001
EXTRACT_MODEL=claude-sonnet-5

# Or any provider speaking the OpenAI chat-completions shape, which is nearly all of
# them including the free tiers. Consulted ONLY when ANTHROPIC_API_KEY is empty, so
# these lines can be left in place once the real key arrives.
#
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#
# Model names change often — take the exact string from your provider's own dashboard.
# One name is enough; it will be used for both jobs.
#
# Worth knowing before pointing this at a free tier: these emails are a client's real
# supplier names, stock levels and prices, and several free tiers train on what you send
# them. Fine for testing against the samples, not for his live inbox.
LLM_BASE_URL=
LLM_API_KEY=
LLM_CLASSIFY_MODEL=
LLM_EXTRACT_MODEL=

# --- Supabase ---
# Project Settings > API
SUPABASE_URL=

# The "secret key" (sb_secret_...), formerly called the service_role key.
# It bypasses row-level security, so it is the one key that must never reach a
# browser, a git commit, or the frontend. Backend and Render only.
SUPABASE_SECRET_KEY=

# The "publishable key" (sb_publishable_...) is NOT needed here — it belongs to the
# React dashboard in Phase 5, where it is safe precisely because RLS is enabled.

# --- Monitoring (Phase 7) ---
SENTRY_DSN=
